; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Zee's Playlot"
run/main_scene="res://game/playlot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

driver/enable_input=true

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/gs_server/plugin.cfg", "res://addons/gs_net/plugin.cfg", "res://addons/gs_player_controller/plugin.cfg", "res://addons/gs_map/plugin.cfg", "res://addons/gs_props/plugin.cfg", "res://addons/gs_leaderboard/plugin.cfg", "res://addons/gs_npc/plugin.cfg", "res://addons/gs_vehicle/plugin.cfg", "res://addons/gs_physics/plugin.cfg", "res://addons/gs_spawn/plugin.cfg", "res://addons/gs_player/plugin.cfg", "res://addons/gs_player_char/plugin.cfg", "res://addons/gs_player_class/plugin.cfg", "res://addons/gs_team/plugin.cfg")

[importer_defaults]

texture={
"detect_3d/compress_to": 0
}

[input]

player_forward={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":87,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
