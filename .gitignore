# Godot 4
.godot/
/android/

# Every gs-* addon is a separate repository. For local development, symlink them:
#   ln -s ../../gs-core/addons/gs_core addons/gs_core
# A shipped build copies them in instead.
/addons/gs_core
/addons/gs_profile
/addons/gs_profiler
/addons/gs_entity
/addons/gs_map
/addons/gs_props
/addons/gs_leaderboard
/addons/gs_ui
/addons/gs_input
/addons/gs_server
# bootstrap fetches the release zip into addons/gs_net/native/bin and export copies it beside the exe (gs-bootstrap: bootstrap-natives).
# bootstrap-natives: gs-net v0.1.38 native/bin
/addons/gs_net
/addons/gs_npc
/addons/gs_vehicle
/addons/gs_achievements
/addons/gs_combat
/addons/gs_loadout
/addons/gs_match
/addons/gs_npc_ai
/addons/gs_npc_ai_director
/addons/gs_stats
/addons/gs_vote
/addons/gs_auth
/addons/gs_browser
/addons/gs_chat
/addons/gs_cloud
/addons/gs_moderation
/addons/gs_platform
/addons/gs_user
/addons/gs_user_avatar
/addons/gs_voice

# Records and zone files written at runtime
/user_data/

# Exports
build/
export_presets.cfg

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/

# Screenshots are evidence for a review, not assets
/screenshots/
/addons/gs_economy
/addons/gs_effects
/addons/gs_spectate
/addons/gs_settings
/addons/gs_menu
/addons/gs_audio
/addons/gs_fx
/addons/gs_console
/addons/gs_peer_to_peer
/addons/gs_procedural_generation
/addons/gs_inventory
/addons/gs_physics
/addons/gs_lighting
/addons/gs_spawn
/addons/gs_bot
/addons/gs_player
/addons/gs_player_controller
/addons/gs_player_char
/addons/gs_animation
/addons/gs_save
/addons/gs_camera
/addons/gs_player_class
/addons/gs_team
/addons/gs_server_query
/addons/gs_game
# gs-sim: optional native library (movement motor, bot senses, snapshot codec); without its built library the GDScript twins run.
# bootstrap fetches this release's library for the machine (gs-bootstrap: bootstrap-natives).
# bootstrap-natives: gs-sim v0.2.12
/addons/gs_sim
/addons/gs_workbench
/addons/gs_weapon
/addons/zee_weapons
/addons/fc_weapons
/addons/gs_workbench
# Optional: natural-disasters, shown in the Addons tab by addons/pg_natural_disasters.
/addons/natural_disasters

# The custom sandbox maps are playlot-maps, a repository and a pack of their own.
# "ci" asks gs-ci (v1.3.0+) to link them on the runner too: the suites load all of them.
# bootstrap-link: playlot-maps/maps ci
/maps/custom
# Optional packs (zz-modern-weapons, zz-medieval-weapons, zz-historical-monsters): gs-bootstrap links
# them by default and skips them under --min; the game runs without.
# bootstrap-optional
/addons/zz_modern_weapons
# bootstrap-optional
/addons/zz_medieval_weapons
# bootstrap-optional
/addons/zz_historical_monsters
# Each weapon pack's shipped profiles (cfg/addons/<pack>/weapon/*.yml): without them the Workbench's
# weapon headings are empty and the packs fire at their scene defaults. The zz ones are skipped under --min.
# bootstrap-link: zee-gs-weapons/cfg/addons/zee_weapons
/cfg/addons/zee_weapons
# bootstrap-link: fc-weapons/cfg/addons/fc_weapons
/cfg/addons/fc_weapons
# bootstrap-link: zz-modern-weapons/cfg/addons/zz_modern_weapons
/cfg/addons/zz_modern_weapons
# bootstrap-link: zz-medieval-weapons/cfg/addons/zz_medieval_weapons
/cfg/addons/zz_medieval_weapons
/cfg/addons
/addons/gs_flashlight
/addons/gs_mobile
/addons/gs_bot_record
/addons/gs_sql
/addons/godot-sqlite
